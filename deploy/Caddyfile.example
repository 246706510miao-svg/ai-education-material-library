materials.for-fdd.xyz {
    request_body {
        max_size 53MB
    }

    handle /mcp* {
        reverse_proxy material-service:8000 {
            flush_interval -1
            transport http {
                read_timeout 130s
                write_timeout 130s
            }
        }
    }

    reverse_proxy material-service:8000 {
        transport http {
            read_timeout 130s
            write_timeout 130s
        }
    }
}

