{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["question", "expected_document_id", "expected_page_start", "expected_page_end", "answerable"],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "expected_document_id": {"type": ["string", "null"]},
    "expected_page_start": {"type": ["integer", "null"], "minimum": 1},
    "expected_page_end": {"type": ["integer", "null"], "minimum": 1},
    "answerable": {"type": "boolean"}
  },
  "additionalProperties": false
}
